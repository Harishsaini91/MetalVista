<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat with <%= room.userId.gmail %></title>
  <link rel="stylesheet" href="/css/chat.css">
</head>
<body>
  <div class="chat-container">
    <header class="chat-header">
      <div class="header-info">
        <h2>💬 Chat with <%= room.userId.gmail %></h2>
        <p>Started: <%= room.createdAt.toLocaleString() %></p>
      </div>
      <button class="back-btn" onclick="window.location.href='/admin/chat'">⬅ Back</button>
    </header>
    
    <main id="chat-messages">
      <% chats.forEach(chat => { %>
        <div class="message <%= chat.sender._id.equals(user._id) ? 'sent' : 'received' %>">
          <div class="message-info">
            <span class="message-sender"><%= chat.sender.gmail %></span>
            <span class="message-time"><%= chat.timestamp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
          </div>

          <% if (chat.message) { %>
            <div class="message-text"><%= chat.message %></div>
          <% } else if (chat.file) { %>
            <% if (chat.fileType === 'image') { %>
              <img src="/images/uploded_image/<%= chat.file %>" alt="Uploaded image" class="chat-file">
            <% } else if (chat.fileType === 'video') { %>
              <video controls class="chat-file">
                <source src="/images/uploded_image/<%= chat.file %>" type="video/mp4">
              </video>
            <% } else if (chat.fileType === 'audio') { %>
              <audio controls class="chat-file">
                <source src="/images/uploded_image/<%= chat.file %>" type="audio/mpeg">
              </audio>
            <% } else { %>
              <a href="/images/uploded_image/<%= chat.file %>" target="_blank" class="chat-file-link">
                📎 Download File
              </a>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </main>

    <footer class="chat-input-section">
      <form id="chat-form" class="chat-form">
        <input type="hidden" id="room-id" value="<%= room._id %>">
        <input type="hidden" id="current-user-id" value="<%= user._id %>">
        <input type="text" id="message-input" placeholder="Type a message..." autocomplete="off">
        <button type="submit" class="send-btn">Send</button>
      </form>

      <form id="file-form" enctype="multipart/form-data" class="file-form">
        <label for="file-input" class="file-label">📎</label>
        <input type="file" id="file-input" name="file">
      </form>
    </footer>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
