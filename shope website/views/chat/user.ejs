<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat with Support</title>
  <!-- <link rel="stylesheet" href="/css/user_chat.css"> -->
  <link rel="stylesheet" href="/css/chat.css">
</head>
<body>
  <div class="chat-container">
    <header class="chat-header">
      <h2>💬 Chat with Support</h2>
      <p class="chat-subtitle">We’re here to help you in real time</p>
    </header>
    
    <main id="chat-messages">
      <% chats.forEach(chat => { %>
        <div class="message <%= chat.sender._id.equals(user._id) ? 'sent' : 'received' %>">
          <div class="msg-info">
            <span class="msg-sender"><%= chat.sender.gmail %></span>
            <span class="msg-time"><%= chat.timestamp.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) %></span>
          </div>
          
          <% if (chat.message) { %>
            <div class="msg-text"><%= chat.message %></div>
          <% } else if (chat.file) { %>
            <% if (chat.fileType === 'image') { %>
              <img src="/images/uploded_image/<%= chat.file %>" class="chat-file" alt="image">
            <% } else if (chat.fileType === 'video') { %>
              <video controls class="chat-file"><source src="/images/uploded_image/<%= chat.file %>" type="video/mp4"></video>
            <% } else if (chat.fileType === 'audio') { %>
              <audio controls class="chat-file"><source src="/images/uploded_image/<%= chat.file %>" type="audio/mpeg"></audio>
            <% } else { %>
              <a href="/images/uploded_image/<%= chat.file %>" target="_blank" class="chat-file-link">📎 Download File</a>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </main>
    
    <footer class="chat-footer">
      <form id="file-form" enctype="multipart/form-data" class="file-form">
        <label for="file-input" class="file-label" title="Attach a file">📎</label>
        <input type="file" id="file-input" name="file">
      </form>

      <form id="chat-form" class="chat-form">
        <input type="hidden" id="room-id" value="<%= room._id %>">
        <input type="hidden" id="current-user-id" value="<%= user._id %>">
        <input type="text" id="message-input" placeholder="Type a message..." autocomplete="off">
        <button type="submit" class="send-btn">Send ➤</button>
      </form>
    </footer>
  </div>
  
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
