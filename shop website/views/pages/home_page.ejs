<section class="carousel-section" id="carouselSection">
  <% if (userRole === 'admin') { %>
    <button class="add-product-btn" onclick="openProductUpload()">➕ Add Product with Details</button>

    <div class="delete-section">
      <form action="/delete_image" method="post">
        <input type="text" id="currentImageName2" name="imageName" readonly>
        <input type="hidden" name="slide2" value="2">
        <button type="submit" class="image_up">Delete</button>
      </form>
    </div>
  <% } %>

  <div class="carousel">
    <div class="carousel-track" id="carouselTrack">
      <% if (slides2 && slides2.length > 0) { %>
        <% slides2.forEach((slide) => { %>
          <div class="carousel-item-wrapper">
            <a href="/product_details?image=<%= slide.name %>"
               class="carousel-item"
               style="background-image: url('./images/uploded_image/<%= slide.name %>');">
            </a>

            <% if (userRole === 'admin') { %>
              <a class="edit-icon"
                 href="#"
                 title="Edit Schema"
                 onclick="openSchemaEditor('<%= slide.name %>'); event.stopPropagation();">
                📝
              </a>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p>No images available.</p>
      <% } %>
    </div>

    <!-- ✅ Scroll controller bar -->
    <div class="scroll-progress" id="scrollBar">
      <div class="scroll-progress-bar" id="scrollProgressBar"></div>
    </div>
  </div>
</section>



  <section>
    <div class="slider2">
      <div class="slide2" style="background-image: url(' ');">
        <a href=" " class="btn image_product_url">More</a>
      </div>
      <button class="prev2" onclick="prevSlide2()">&#10094;</button>
      <button class="next2" onclick="nextSlide2()">&#10095;</button>
      <div class="slide2-number" id="slide2-number">1 / 3</div>
    </div>
  </section>

  <div class="vertical-line"></div>

  <div class="about">
    <h1>Jai Jeen Mata Welding Workshop</h1>
    <p>Your Trusted Partner for Superior Metalwork and Welding Solutions</p>
  </div>

  <section class="services">
    <h2>Our Services</h2>
    <ul>
      <li>✅ Gates, Grills, Railings</li>
      <li>✅ Section Windows, Safety Grills, Jalis (Mesh Designs)</li>
      <li>✅ Balustrades, Shutters, and Custom Metal Fabrication</li>
      <li>✅ Specialized in Steel Gates, Railings, Counters, and other steelworks</li>
    </ul>
  </section>

  <section class="why-choose">
    <h2>Why Choose Jai Jeen Mata Welding Workshop?</h2>
    <ul>
      <li>💎 High-Quality Materials: Built to last with superior-grade steel and metals.</li>
      <li>🎨 Customized Designs: Tailored to match your specific needs and preferences.</li>
      <li>⏱️ Timely Delivery: We value your time and ensure projects are completed as promised.</li>
      <li>💰 Affordable Pricing: Premium work at competitive rates.</li>
      <li>🛠️ Expert Craftsmanship: Years of experience and attention to detail in every project.</li>
    </ul>
  </section>

  <section class="location">
    <h2>Our Location</h2>
    <p style="color: green; text-decoration:underline">
  <a href="https://maps.app.goo.gl/KeB3nFaW9F47aiGP8" target="_blank" style="text-decoration: none; color: inherit;">
    📍 Daya nagar, narnaul Bypass Road, near BPS school (BHARTI PUBLIC SR SEC SCHOOL), Narnaul, Mahendragarh, Haryana, pin-123001
  </a>
</p>

  <p>Our convenient location ensures easy access for all customers in and around the Narnaul area.</p>
  </section>

  <section class="contact">
    <h2>Let’s Bring Your Vision to Life!</h2>
    <p>Whether it’s a sturdy gate, sleek railing, or a modern steel counter, Jai Jeen Mata Welding Workshop is your one-stop solution.</p>
    <p>📞 <a href="tel:+YourPhoneNumber">Contact Us Today</a></p>
    <p>🛠️ Visit Us at Our Workshop: Explore our craftsmanship and discuss your next project in detail!</p>
  </section>

  <footer>
    <div class="footer-container">
      <!-- Footer content omitted for brevity -->
    </div>
    <div class="footer-bottom">
      <p>&copy; 2025 Your Company. All rights reserved. | Privacy | Terms</p>
    </div>
  </footer>

  <script>
    window.slidesData1 = <%- JSON.stringify(slides) %>;
    window.slidesData2 = <%- JSON.stringify(slides2) %>;
  </script>
  <script src="/js/slider.js"></script>
  <script src="/js/scroll-helper.js"></script>
  <script src="/js/slider1.js"></script>
  <script src="/js/slider2.js"></script>
  <script src="/js/search.js"></script>
  <script src="/js/scrollbar_adn_cursor.js"></script>

</body>






</html>
