<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Section</title>
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet" href="/css/scroll-helper.css">
  <link rel="stylesheet" href="/css/homepage.css">
</head>

<body>
  <!-- 1️⃣ Header Section -->
  <header class="header">
    <div class="slider">
      <div class="slide active" style="background-image: url('./images/top_slide_image/top_sliding_image6.jpg');">
        
        <!-- 🔹 Navbar -->
        <nav class="navbar">
                  <div class="logo" ><img src="./images/logo/shope_logo.svg" alt="Logo"></div>

          <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/product?category=indoor">Product</a></li>
            <% if (!userRole) { %>
              <li><a href="/sign_in">Sign In</a></li>
            <% } else { %>
              <li><a href="/logout">Logout</a></li>
            <% } %>
          </ul>

          <!-- 🔹 Menu icon (mobile) -->
          <div class="menu-icon" onclick="toggleMenu()">☰</div>

          <!-- 🔹 Toggle Menu -->
          <div class="menu" id="menu">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/product?category=indoor">Product</a></li>
              <% if (!userRole) { %>
                <li><a href="/sign_in">Sign In</a></li>
              <% } else { %>
                <li><a href="/logout">Logout</a></li>
              <% } %>
            </ul>
          </div>
        </nav>

        <!-- 🔹 Slider Title and Location -->
        <h4 class="slider-title">
          <span class="welcome-text">Welcome to My Workshop</span><br>
          Jai Jeen Mata Welding Workshop<br>
          Contact No. 8930377979
        </h4>
        <a href="https://maps.app.goo.gl/U28yWXRhCx8EbUCf8" class="btn" target="_blank">
          <img src="./images/logo/location.svg" alt="">
        </a>
      </div>
    </div>
  </header>

  <!-- 2️⃣ Scroll Helper -->
  <div id="scroll-wrapper">
    <div id="scroll-helper">
      <div id="scroll-main-btn" title="Scroll Options">⇅</div>
      <div id="scroll-options">
        <button id="scroll-top">⬆</button>
        <button id="scroll-bottom">⬇</button>
      </div>
    </div>
  </div>

  <!-- 3️⃣ About Content -->
  <main>
    <section>
      <h2>Welcome to Jai Jeen Mata Welding Workshop</h2>
      <p>Where craftsmanship meets reliability...</p>
    </section>

    <section>
      <h2>Who We Are</h2>
      <p>Jai Jeen Mata Welding Workshop is a locally owned business based in Narnaul (Rewari).</p>
    </section>

    <section>
      <h2>Our Mission</h2>
      <p>To provide <span class="highlight">top-notch metalworking services</span> that exceed expectations.</p>
    </section>

    <section>
      <h2>Our Expertise</h2>
      <ul>
        <li>Gates, Grills, and Railings</li>
        <li>Steel Windows, Safety Grills, Mesh Designs</li>
        <li>Balustrades, Shutters, Counters, and more</li>
      </ul>
    </section>
  </main>

  <!-- 4️⃣ About Self -->
  <section class="about_self">
    <h2>Meet Our Leadership</h2>
    <div class="about-container">
      <div class="profile-card">
        <img src="./images/contact_image/revinder.jpg" alt="Profile 1">
        <h3>Ravinder Saini</h3>
        <p>CEO & Co-founder</p>
        <h4>📞 8930377979</h4>
      </div>

      <div class="profile-card">
        <img src="./images/contact_image/abhey singh.jpg" alt="Profile 2">
        <h3>Abhey Singh</h3>
        <p>Finance Director</p>
        <h4>📞 8396008219</h4>
      </div>

      <div class="profile-card">
        <img src="./images/contact_image/WhatsApp Image 2025-05-27 at 7.42.38 PM.jpeg" alt="Profile 3">
        <h3>Harish</h3>
        <p>Chief Technology Officer</p>
        <h4>📞 8930377979</h4>
      </div>
    </div>
  </section>

  <!-- 5️⃣ Footer -->
  <footer>
    <p>&copy; 2025 Jai Jeen Mata Welding Workshop. All Rights Reserved.</p>
  </footer>

  <!-- JS -->
  <script>
    function toggleMenu() {
      const menu = document.getElementById('menu');
      menu.classList.toggle('show');
    }
  </script>
  <script src="/js/scroll-helper.js"></script>
</body>
</html>
